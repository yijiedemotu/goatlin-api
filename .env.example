# ---------------------------------------------------------------------------
# 复制为 .env 后按需修改：cp .env.example .env
# 所有变量均可被同名大写环境变量覆盖（pydantic-settings 约定）
# ---------------------------------------------------------------------------

# 运行环境：local | staging | production
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库：本地默认 SQLite（零依赖启动）；生产建议 PostgreSQL
# PostgreSQL 示例：postgresql+asyncpg://user:pwd@localhost:5432/goalfin
DATABASE_URL=sqlite+aiosqlite:///./data/goalfin.db
DB_ECHO=false

# JWT：生产环境务必替换为随机值
# 生成命令：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-key-please-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256
JWT_ISSUER=goalfin-api

# CORS：多个来源用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 限流：默认进程内令牌桶；配置 REDIS_URL 后切换为 Redis 固定窗口（多实例共享）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_WINDOW_SECONDS=60
# REDIS_URL=redis://localhost:6379/0

# 日志：json（生产，便于采集）| console（本地，带颜色）
LOG_LEVEL=INFO
LOG_FORMAT=console
